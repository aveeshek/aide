# Copy this file to .env. Never commit the populated .env file.

# ---------- Neo4j (native Windows service) ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-now
NEO4J_DATABASE=neo4j

# ---------- Knowledge repository ----------
# A relative dot resolves to the repository root when commands are run from the root.
KNOWLEDGE_ROOT=.
CANONICAL_DIR=wiki
OPENWIKI_DIR=openwiki
GENERATED_DIR=generated
OPERATIONS_DIR=operations
GRAPH_GROUP_ID=engineering-knowledge
MAX_GRAPH_DEPTH=3
MAX_SEARCH_RESULTS=12

# ---------- Graphiti temporal enrichment ----------
# The deterministic Neo4j graph works without an LLM key.
ENABLE_GRAPHITI=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
SEMAPHORE_LIMIT=4
GRAPHITI_TELEMETRY_ENABLED=false

# ---------- MCP ----------
# Kiro starts the MCP process locally over stdio. HTTP is optional for debugging only.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
LOG_LEVEL=INFO

# ---------- OpenWiki ----------
OPENWIKI_PROVIDER=openai
OPENWIKI_MODEL_ID=
OPENWIKI_TELEMETRY_DISABLED=1
